# ==============================================================================
# .gitignore for clothes-shop-frontend (Next.js / TypeScript / React 19 / WET)
# ==============================================================================

# 1. Dependencies
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# 2. Next.js & Build Outputs
# Note: next.config.mjs specifies output: "export", emitting static files to /out
.next/
out/
build/
dist/
.swc/
.turbo/
.vercel/

# 3. TypeScript & Compiler Caches
*.tsbuildinfo
next-env.d.ts.bak

# 4. Environment Variables & Local Secrets
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.vault

# Explicitly keep environment template
!.env.example

# 5. Testing, Coverage & Reports (Vitest / Playwright)
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# 6. Temporary Files & Portability Test Copies
# Temporary directories created by test suites or portability check runners
tmp/
.tmp/
temp/
.temp/
*.tmp
isolated_*/

# 7. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 8. Editor & IDE Settings
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# Preserve shared VS Code recommendations if added, ignore local user workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# 9. AI Tools & Code Assistants
.qodo/

# 10. Operating System Artifacts
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini

# Linux
*~

# ==============================================================================
# Whitelist / Preserved Project Assets (Ensure required files are kept)
# ==============================================================================
!next-env.d.ts
!src/**/contracts/host-stubs.d.ts
!src/**/locales/*.json
!src/**/mocks/*.json
!public/images/*.svg
!*.md
!docs/
