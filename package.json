{
  "name": "clothes-shop-next",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "format": "prettier --write src tests docs *.json *.mjs",
    "format:check": "prettier --check src tests docs *.json *.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test:e2e": "playwright test",
    "check:portability": "node scripts/check-portability.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "3.10.0",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "date-fns": "3.6.0",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "zod": "3.25.76",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "4.10.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-boundaries": "7.4.4",
    "jsdom": "26.1.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
